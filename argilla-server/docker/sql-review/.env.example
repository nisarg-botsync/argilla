# Copy to .env next to docker-compose.yaml.

# QuestDB HTTP address, as seen from the Argilla container. Required.
# Use http://host.docker.internal:9000 for a QuestDB on this host.
QUESTDB_URL=http://questdb-host:9000

# Seconds to wait for a QuestDB query
QUESTDB_TIMEOUT=60

# Seconds before a run of the original query is flagged as a performance issue
SLOW_QUERY_SECONDS=3

# Argilla owner login
ARGILLA_USERNAME=argilla
ARGILLA_PASSWORD=12345678
ARGILLA_API_KEY=argilla.apikey
ARGILLA_WORKSPACE=default
